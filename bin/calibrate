#!/bin/sh
# Capability calibration harness: runs the versioned suite against live models and
# normalizes the grades into catalog scores (evidence/capability-calibration-v1.md).
#
# Calls real models, so it is never part of bin/check or CI.
#
#   DOCKERLM_BASE_URL=http://host:8000/v1 bin/calibrate run dockerlm mimo-v2.6-distill-9b xiaomimimo/mimo-v2.6-distill-qwen-9b
#   bin/calibrate run ollama-cloud gpt-oss:120b openai/gpt-oss-120b
#   bin/calibrate run claude-cli claude-sonnet-4-6 anthropic/claude-sonnet-4-6
#   bin/calibrate score
#   bin/calibrate matrix        # virtual-policy winners + sensitivity over the effective catalog
#                               # (needs DATABASE_URL, or --bootstrap-only)
set -eu

cd "$(dirname "$0")/.."

if [ "${1:-}" = matrix ]; then
  shift
  exec bun apps/api/bench/calibration/matrix.ts "$@"
fi
bun apps/api/bench/calibration/run.ts "$@"
# Current result files and scores.json are committed evidence; keep them in the repository's
# formatter shape. Historical artifacts are left byte-for-byte as recorded.
case "${1:-}" in
  run) bun run --silent biome format --write evidence/capability-calibration-v1/results >/dev/null ;;
  score) bun run --silent biome format --write evidence/capability-calibration-v1/scores.json >/dev/null ;;
esac
